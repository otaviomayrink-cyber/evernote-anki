  {"id": "sf1", "tipo": "funcao", "expr": "0.9*x**0.5", "dominio": [0, 58], "familia": "oferta", "rotulo": "s₁·f(k)", "estado": "inicial"},
  {"id": "sf2", "tipo": "funcao", "expr": "1.35*x**0.5", "dominio": [0, 58], "familia": "oferta", "rotulo": "s₂·f(k)"},
