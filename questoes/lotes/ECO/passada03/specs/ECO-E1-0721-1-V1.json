  {"id": "E1", "intersecao": ["sf1", "dep"], "indice": 1, "projetar": "x", "rotulo_x": "k₁*"},
  {"id": "E2", "intersecao": ["sf2", "dep"], "indice": 1, "projetar": "x", "rotulo_x": "k₂*"},
  {"id": "Y1", "sobre": "f", "x": "E1.x", "projetar": "y", "rotulo_y": "y₁*", "marcar": true},
  {"id": "Y2", "sobre": "f", "x": "E2.x", "projetar": "y", "rotulo_y": "y₂*", "marcar": true}
 ],
 "checar": ["E2.x > E1.x", "Y2.y > Y1.y", "abs(E1.x - 20.25) < 0.01", "abs(E2.x - 45.5625) < 0.01"]
