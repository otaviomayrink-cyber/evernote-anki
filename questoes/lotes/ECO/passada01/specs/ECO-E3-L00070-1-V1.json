  {"id": "C2", "tipo": "funcao", "expr": "1.5*x", "dominio": [0, 9.2], "familia": "oferta", "rotulo": "CMgA₂"},
  {"id": "T", "tipo": "horizontal", "y": 6, "x": [0, 15.5], "familia": "destaque", "rotulo": "taxa t = 6"},
  {"id": "L", "tipo": "vertical", "x": 8, "y": [0, 13.2], "familia": "referencia", "rotulo": "limite uniforme"}
 ],
 "pontos": [
