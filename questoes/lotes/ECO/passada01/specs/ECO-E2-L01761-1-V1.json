{"id": "ECO-E2-L01761-1-V1", "uso": "verso",
 "legenda": "Na vacina, a externalidade está no consumo: o benefício marginal social (BMgS) fica acima da demanda privada (D = BMgP), enquanto a oferta (O = CMg, privado igual ao social) não muda. O mercado para em qm, abaixo do ótimo q*; o triângulo vermelho (PM) é o peso morto da subvacinação.",
 "eixos": {"x": "q", "y": "p", "xmax": 10.5, "ymax": 11},
 "curvas": [
  {"id": "D", "tipo": "funcao", "expr": "7 - 0.8*x", "dominio": [0, 8], "familia": "demanda", "rotulo": "D = BMgP"},
  {"id": "BS", "tipo": "funcao", "expr": "10.4 - 0.8*x", "dominio": [0, 10], "familia": "destaque", "rotulo": "BMgS"},
  {"id": "S", "tipo": "funcao", "expr": "1 + 0.8*x", "dominio": [0, 10], "familia": "oferta", "rotulo": "O = CMg"}
 ],
 "pontos": [
  {"id": "Em", "intersecao": ["D", "S"], "rotulo": "Eₘ", "projetar": "x", "rotulo_x": "qm", "rotulo_desloc": [12, -16]},
  {"id": "Eo", "intersecao": ["BS", "S"], "rotulo": "E*", "projetar": "x", "rotulo_x": "q*", "rotulo_desloc": [-8, 16]},
  {"id": "Bm", "sobre": "BS", "x": "Em.x", "marcar": false}
 ],
 "areas": [
  {"tipo": "poligono", "vertices": ["Em", "Bm", "Eo"], "papel": "peso_morto", "rotulo": "PM", "rotulo_xy": ["Em.x+0.6", "Em.y+1.1"]}
 ],
 "setas": [{"de": [0.8, "D(0.8)+0.12"], "para": [0.8, "BS(0.8)-0.12"], "estilo": "<|-|>"}],
 "textos": [{"xy": [1.0, 7.2], "texto": "benefício externo", "cor": "vermelho", "tamanho": 12}],
 "checar": ["Eo.x > Em.x", "Eo.y > Em.y", "BS(Em.x) > Em.y", "abs((BS(2) - D(2)) - (BS(5) - D(5))) < 0.01"]}
