  {"id": "Q1", "sobre": "C1", "x": 8, "rotulo": "4", "rotulo_desloc": [10, -12]},
  {"id": "Q2", "sobre": "C2", "x": 8, "rotulo": "12", "rotulo_desloc": [10, 0]}
 ],
